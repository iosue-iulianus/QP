// Copy this file to Secrets.swift (in the same folder) and fill in your
// credentials before building. Secrets.swift is gitignored; never commit it.
//
//   cp QuPi/Secrets.swift.template QuPi/Secrets.swift
//
// The placeholder values below are fine if you don't need scrobbling.
// The app builds and runs; only Trakt / Last.fm sign-in won't work.
//
// Trakt:  Register at https://trakt.tv/oauth/applications/new
//         Set redirect URI to: qupi://trakt-auth
//
// Last.fm: Register at https://www.last.fm/api/account/create
//          Set callback URL to: qupi://lastfm-auth

enum TraktSecrets {
    static let clientID     = "YOUR_TRAKT_CLIENT_ID"
    static let clientSecret = "YOUR_TRAKT_CLIENT_SECRET"
    static let redirectURI  = "qupi://trakt-auth"
}

enum LastFMSecrets {
    static let apiKey       = "YOUR_LASTFM_API_KEY"
    static let sharedSecret = "YOUR_LASTFM_SHARED_SECRET"
    static let callbackURL  = "qupi://lastfm-auth"
}
